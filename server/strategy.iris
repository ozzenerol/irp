import "config"

pub enum StrategyDispatchError {
    invalidStrategy
}

pub struct StrategyDispatch {
    config.StrategyType         strategy
    List[config.Backend]        backends
    Atomic[i64]                 counter
}

pub StrategyDispatch *newStrategyDispatch(config.StrategyType strategy, List[config.Backend] backends) {
    StrategyDispatch *sd = alloc(StrategyDispatch, 1).ptr
    sd.strategy = strategy
    sd.backends = backends
    return sd
}

pub !config.Backend StrategyDispatch.dispatch() {
    Error invalidStrategyError = error(StrategyDispatchError.invalidStrategy, "invalid strategy {self.strategy}")

    match self.strategy {
        config.StrategyType.roundRobin          => return self.roundRobin()
        config.StrategyType.weightedRoundRobin  => return self.weightedRoundRobin()
        _                                       => return invalidStrategyError
    }
}

config.Backend StrategyDispatch.roundRobin() {
    n := self.counter.add(1) - 1
    return self.backends.at(n % self.backends.len)
}

config.Backend StrategyDispatch.weightedRoundRobin() {
    return config.Backend {} 
}
