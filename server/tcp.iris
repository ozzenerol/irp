import "config"
import log, net

pub struct Server {
    config.Config *cfg
    i8 fd = -1
    bool running = false
}

pub Server *newServer(config.Config *cfg) {
    if cfg is null {
        log.error("cfg arg is null")
        return null
    }
    
    srv := Server {
        cfg: cfg
    }

    Server *s = alloc(Server, 1).ptr 
    *s = srv
    return s
}

pub void Server.start() {
    StrategyDispatch *strategy = newStrategyDispatch(self.cfg.routing.strategy, self.cfg.backends)
    log.debug("configured the strategy dispatch: {strategy.strategy}")

    ln := net.listen(self.cfg.proxy.listenPort) catch e {
        log.error("could not listen on port {self.cfg.proxy.listenPort}: {e.message}")
        return
    }

    log.info("tcp server started on {self.cfg.proxy.listenAddress}:{self.cfg.proxy.listenPort}")

    cores := self.cfg.proxy.cores
    for i in 1..cores {
        thread self.acceptLoop(ln, strategy)
    }

    self.acceptLoop(ln, strategy)
}

void Server.acceptLoop(net.Listener ln, StrategyDispatch *strategy) {
    for {
        conn := ln.accept() catch e {
            log.warn("could not accept connection: {e.message}")
            continue
        }
        spawn self.handle(conn, strategy)
    }
}

void Server.handle(net.Conn connection, StrategyDispatch *strategy) {
    defer connection.close()

    backend := strategy.dispatch() catch e {
        log.error("could not dispatch the request: {e.message}")
        return
    }

    // Converting because net.dial is a piece of shit and takes nanoseconds
    timeout := i64(backend.timeoutSeconds) * 1s

    upstream := net.dial(backend.host, backend.port, timeout) catch e {
        log.error("could not connect to upstream {backend.host}:{backend.port} - {e.message}")
        return
    }
    
    defer upstream.close()

    done := chan[bool](2)
    defer done.free()

    spawn pipe(connection, upstream, done)
    spawn pipe(upstream, connection, done)

    _ = <-done
    _ = <-done
}

void pipe(net.Conn from, net.Conn to, chan[bool] done) {
    u8[16384] buf
    for {
        n := from.read(buf) catch e { 
            break 
        }

        if n == 0 { 
            break 
        }
        
        to.write(buf[0:n]) catch e {
            break
        }
    }

    from.interrupt()
    to.interrupt()
    done <- true
}
