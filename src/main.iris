import "src/config", "src/server"
import log, os, flags

@flags
struct Args {
    str configFile = "config.json"
}

i32 main() {
    scoped args := flags.parse(Args)

    config.Config *cfg = config.load(args.configFile)
    defer free(cfg)

    os.exit(1) if cfg == null

    log.info("config {args.configFile} loaded successfully")
    log.info("loaded {cfg.backends.len} backends")
    log.info("using {cfg.proxy.cores} cores")

    server.Server *srv = server.newServer(cfg)
    srv.start()

    free(cfg)
    free(srv)

    os.exit(0)
}
